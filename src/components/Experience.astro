---
import I18NDebug from "@ariaskit/astro-i18n/I18NDebug.astro";

type Out = { key: string; value: string };

interface JobExp {
    period: Out;
    role: Out;
    company: Out;
    description: Out;
}

interface Props {
    title: Out;
    jobs: JobExp[];
}

const { title, jobs } = Astro.props as Props;
---

<section id={title.value.toLowerCase()} class="scroll-mt-40">
    <h2 class="section-label mb-8">
        <I18NDebug key={title.key}>
            {title.value}
        </I18NDebug>
    </h2>
    <ul class="space-y-7">
    {
        jobs.map((job) => (
                <li class="grid grid-cols-1 gap-1 md:grid-cols-12 md:gap-4">
                    <span class="text-faint text-[0.8rem] tracking-wide md:col-span-3 md:pt-0.5">
                        <I18NDebug key={job.period.key}>
                            {job.period.value}
                        </I18NDebug>
                    </span>
                    <div class="md:col-span-9">
                        <div class="text-[0.95rem]">
                            <I18NDebug key={job.role.key}>
                                <span class="font-medium">{job.role.value}</span>
                            </I18NDebug>
                            <span class="text-faint mx-1.5">·</span>
                            <I18NDebug key={job.company.key}>
                                <span class="text-muted">{job.company.value}</span>
                            </I18NDebug>
                        </div>
                        <I18NDebug key={job.description.key}>
                            <p class="text-[0.87rem] text-muted mt-1 leading-relaxed" set:html={job.description.value} />
                        </I18NDebug>
                    </div>
                </li>
        ))
    }
    </ul>
</section>
